{
  "name": "agile-sapiens",
  "version": "1.0.7",
  "description": "AGILE SAPIENS — The Future of Work in the Age of Artificial Intelligence | Scientific Popular Monograph",
  "type": "module",
  "scripts": {
    "dev": "hugo server --buildDrafts --buildFuture",
    "build": "hugo --gc --minify",
    "validate": "node scripts/validate-content.js",
    "validate:level1": "node scripts/validate-content.js --check=level1",
    "validate:voice": "node scripts/validate-content.js --check=voice-gate",
    "validate:schema": "node scripts/validate-content.js --check=frontmatter",
    "validate:sources": "node scripts/validate-content.js --check=sources",
    "validate:brand": "node scripts/validate-content.js --check=brand",
    "deploy": "bash scripts/deploy-to-vps.sh",
    "purge-cache": "node scripts/purge-cloudflare.js",
    "quality-gates": "npm run validate && npm run build",
    "quality:full": "bash scripts/integrated-quality-pipeline.sh",
    "quality:format": "node scripts/format-consistency-gates.js",
    "quality:phantom": "node scripts/phantom-detection-gates.js",
    "quality:check": "bash scripts/quality-check.sh",
    "quality:status": "bash scripts/quality-check.sh status",
    "test:e2e": "playwright test"
  },
  "keywords": [
    "agile-sapiens",
    "artificial-intelligence",
    "future-of-work",
    "scientific-popular",
    "monograph",
    "workplace-transformation",
    "folkup"
  ],
  "author": "FolkUp",
  "license": "MIT",
  "dependencies": {
    "glob": "^10.3.0",
    "js-yaml": "^4.1.1",
    "puppeteer": "^24.43.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/FolkUp/agile-sapiens.git"
  },
  "homepage": "https://sapiens.folkup.life",
  "bugs": {
    "url": "https://github.com/FolkUp/agile-sapiens/issues"
  }
}
